# Copiar a cloud/.env en el VPS y completar. Este archivo de ejemplo NO lleva valores reales.
DOMINIO=agrotecnet.cloud

# EMQX
EMQX_DASHBOARD_USER=admin
EMQX_DASHBOARD_PASS=cambiar
MQTT_PASS_GATEWAY_RPI=cambiar
MQTT_PASS_SVC_NODERED=cambiar
MQTT_PASS_SVC_ANOMALIAS=cambiar

# TimescaleDB
POSTGRES_USER=iot
POSTGRES_PASSWORD=cambiar
POSTGRES_DB=cafe

# Node-RED (login del editor y del dashboard)
NODERED_ADMIN_USER=admin
NODERED_ADMIN_PASS_HASH=generar_con_node-red-admin_hash-pw

# Alertas WhatsApp (CallMeBot)
CALLMEBOT_PHONE=+57XXXXXXXXXX
CALLMEBOT_APIKEY=cambiar
