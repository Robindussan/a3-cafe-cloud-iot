#pragma once

// ---- Modo normal: red WiFi propia de la Raspberry (fog) y NanoMQ con la CA de la finca
#define WIFI_SSID     "SSID_DE_LA_RASPBERRY"
#define WIFI_PASS     "CLAVE_DE_LA_RASPBERRY"
#define MQTT_HOST     "fog.finca"      // nombre del certificado del NanoMQ (dnsmasq de la RPi)
#define MQTT_PORT     8883
#define NTP_SERVER    "192.168.50.1"   // chrony en la Raspberry (los nodos no salen a Internet)
#define MQTT_USER_01  "marquesina-01"
#define MQTT_PASS_01  "cambiar"
#define MQTT_USER_02  "marquesina-02"
#define MQTT_PASS_02  "cambiar"
#define MQTT_USER_03  "marquesina-03"
#define MQTT_PASS_03  "cambiar"

